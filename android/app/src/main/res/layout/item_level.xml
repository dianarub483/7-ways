<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/level_cell"
    android:layout_width="@dimen/level_cell"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/gap_s"
    android:background="@drawable/shape_level_cell"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/btn_ghost_height"
    android:orientation="vertical"
    android:paddingTop="@dimen/gap_s"
    android:paddingBottom="@dimen/gap_s">

    <TextView
        android:id="@+id/level_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/level_number_default"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/level_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_xs"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/level_star_one"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageView
            android:id="@+id/level_star_two"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

        <ImageView
            android:id="@+id/level_star_three"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_star_outline" />

    </LinearLayout>

    <ImageView
        android:id="@+id/level_lock"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="@dimen/gap_xs"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />

</LinearLayout>
